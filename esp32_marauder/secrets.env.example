# Template — copy to secrets.env and fill real values. secrets.env is GITIGNORED.
# Real credentials are injected as -D flags at compile time and MUST NOT be
# committed to the repo (they are extractable from the firmware binary too).

# STA hotspot (external AP the device joins as a client)
API_HOTSPOT_SSID=CHANGE_ME
API_HOTSPOT_PASSWORD=CHANGE_ME

# Management AP (the ESP's own AP, 192.168.4.1)
API_MGMT_AP_SSID=CHANGE_ME
API_MGMT_AP_PASSWORD=CHANGE_ME
